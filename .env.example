# Copy to .env and fill in. Never commit .env.
# Service account from Strata Cloud Manager > Settings > Identity & Access.
SCM_CLIENT_ID=your-sa@<tsg_id>.iam.panserviceaccount.com
SCM_CLIENT_SECRET=changeme
SCM_SCOPE=tsg_id:<tsg_id>
# Optional overrides (provider defaults shown)
# SCM_HOST=api.sase.paloaltonetworks.com
# SCM_AUTH_URL=https://auth.apps.paloaltonetworks.com/auth/v1/oauth2/access_token
